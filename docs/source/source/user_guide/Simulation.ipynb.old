   "source": [
    "#  different settings :\n",
    "\n",
    "# - a more conservative profile (more conservative in corners and downhill, but still realistic uphill)\n",
    "my_profile=CyclistBehavior(uphill='realistic', \n",
    "                           downhill='conservative', \n",
    "                           corner='conservative')\n",
    "# - a more aggressive profile (more aggressive in corners and downhill, but still realistic uphill)\n",
    "my_profile=CyclistBehavior(uphill='realistic', \n",
    "                           downhill='aggressive', \n",
    "                           corner='aggressive')\n",
    "my_profile.display()\n",
    "# when you are very advanced into the simultion and want to test the sensitivity of your results to the cyclist behavior,\n",
    "#  you can also just change one parameter at a time, for example :\n",
    "my_profile.downhill_vitesse_max_absolue= 30 # increase the maximum absolute speed on downhill sections to 30 m/s (108 km/h)\n",
    "my_profile.display()\n",
    "# profile deemed satisfactory can be saved to a file \n",
    "my_profile.save(dirpath=\"/tmp\",\n",
    "                filename=\"my_profile.json\")\n",
    "#   and reused later:\n",
    "my_profile_loaded = CyclistBehavior.load(dirpath=\"/tmp\",\n",
    "                                         filename=\"my_profile.json\")\n",
    "\n",
    "\n"
   ]
